
@model InventoryManagement.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h2>Product Details</h2>

<div class="card">
    <div class="card-header">
        <h5>@Model.Name</h5>
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Product ID</dt>
            <dd class="col-sm-9">@Model.ProductId</dd>

            <dt class="col-sm-3">Product Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">SKU</dt>
            <dd class="col-sm-9">@Model.SKU</dd>

            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">
                @Model.Price.ToString("N2")
            </dd>

            <dt class="col-sm-3">Quantity</dt>
            <dd class="col-sm-9">@Model.Quantity</dd>

            <dt class="col-sm-3">Reorder Level</dt>
            <dd class="col-sm-9">@Model.ReorderLevel</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">
                @(Model.Category?.Name ?? "N/A")
            </dd>

            <dt class="col-sm-3">Supplier</dt>
            <dd class="col-sm-9">
                @(Model.Supplier?.Name ?? "N/A")
            </dd>
        </dl>

        @if (Model.Quantity <= Model.ReorderLevel)
        {
            <div class="alert alert-warning">
                Low stock! Please restock this product.
            </div>
        }
           @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit"
           asp-route-id="@Model.ProductId"
           class="btn btn-warning">Edit</a>
    }
        <a asp-action="Index"
           class="btn btn-secondary">Back to List</a>
    </div>
</div>
